# Copy to .env and fill in. Restart `npm run dev` after changing.

# Public URL of the live site (used for sitemap.xml, robots.txt, canonical and Open Graph tags).
SITE_URL=

# --- Quotation form delivery: set ONE of these ---------------------------------
# Recommended: free key from https://web3forms.com (enter the studio's business email there).
VITE_WEB3FORMS_KEY=
# Or a Formspree form id (the part after /f/ in your form URL).
VITE_FORMSPREE_ID=
# Or your own endpoint that accepts JSON and returns {"success": true}.
VITE_FORM_ENDPOINT=
# If all three are empty, the form posts to FormSubmit using the email in src/data/site.js.
# The first enquiry triggers an activation email to that inbox; click the link once to start delivery.
